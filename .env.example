# MongoDB (free local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/bharat-cares-pathshala

# JWT Secret (change this to a long random string)
JWT_SECRET=change-this-to-a-very-long-random-secret-key-2024

# Server
PORT=5000
NODE_ENV=development

# Google APIs — Service Account (optional, for Drive + Sheets sync)
# Create a service account at console.cloud.google.com
# Enable Google Drive API and Google Sheets API
# Share your Drive folder and Sheet with the service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-google-drive-folder-id
GOOGLE_SHEETS_ID=your-google-sheets-spreadsheet-id

# Client URL for CORS
CLIENT_URL=http://localhost:3000
